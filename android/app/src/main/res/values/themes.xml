<resources>
    <!-- Window-level theme only (pre-Compose background); all real styling is Material 3 in Compose.
         Dark parent: the app UI is always dark, so the window never flashes white on launch. -->
    <style name="Theme.QuatrioAi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
