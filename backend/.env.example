# Copy to .env and fill in. Every value below is optional except OPENROUTER_API_KEY.

# --- OpenRouter (model gateway) ---
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Attribution headers sent to OpenRouter (HTTP-Referer / X-Title)
# APP_URL=https://example.com
# APP_NAME=campus-ai
# UPSTREAM_TIMEOUT_SECONDS=90

# --- Money ---
# Rupees per US dollar. OpenRouter bills in USD; every charge is converted with this. Update freely;
# Read at startup: edit and restart (./run.sh) to apply.
USD_INR_RATE=93
# Fee recovery as a % of the USER-VISIBLE charge: charge = real_cost / (1 - MARGIN_PCT/100).
# 17.65 = the BLUEPRINT §7 fee stack (Play 11% + Razorpay 2.36% + OpenRouter 5.5%: Rs20 -> Rs16.47 of
# credit), so a student who spends the whole wallet breaks even and profit comes from unspent balance
# (BLUEPRINT §12). Not a per-message markup: don't set it above the fee stack. See NOTES.md §1.
MARGIN_PCT=17.65
# The §7 fee stack; only used for a startup warning if MARGIN_PCT differs from it.
# PLATFORM_FEE_PCT=17.65
# MIN_TOPUP_INR=20
# MAX_TOPUP_INR=2000
# MAX_WALLET_BALANCE_INR=10000

# --- Payments ---
# mock = dev stand-in that "succeeds" on /v1/wallet/topup/confirm (only allowed with DEV_MODE=true).
# razorpay = not implemented yet (see app/payments.py).
PAYMENT_PROVIDER=mock
DEV_MODE=true
# Base URL the phone can reach; used to build checkout_url (e.g. http://10.0.2.2:8000 for the emulator).
PUBLIC_BASE_URL=http://localhost:8000

# --- Storage ---
DATABASE_PATH=data/campus_ai.db

# --- Abuse limits ---
# RATE_LIMIT_PER_MINUTE=60            # any authenticated endpoint, per token
# CHAT_RATE_LIMIT_PER_MINUTE=12       # POST /v1/chat, per token
# REGISTER_LIMIT_PER_HOUR_PER_IP=20

# --- Tiers (blended USD per 1M tokens, 3 parts input : 1 part output) ---
# MODELS_REFRESH_SECONDS=21600
# FAST_MAX_USD_PER_M=0.75
# SMART_MAX_USD_PER_M=4
# EXPERT_MAX_USD_PER_M=25
# TRUSTED_PROVIDERS=anthropic,openai,google,meta-llama,mistralai,qwen,deepseek,x-ai
# Optional pins (still priced from the live list):
# MODEL_FAST=
# MODEL_SMART=
# MODEL_EXPERT=
# Reasoning effort preference per tier (reasoning tokens are billed as output):
# REASONING_EFFORT_FAST=none,minimal,low
# REASONING_EFFORT_SMART=low,minimal,none
# REASONING_EFFORT_EXPERT=medium,low

# --- Per-message limits / estimates ---
# MAX_OUTPUT_TOKENS=1500
# MIN_OUTPUT_TOKENS=256
# MAX_INPUT_TOKENS=32000
# MAX_MESSAGE_CHARS=8000
# MAX_IMAGE_BYTES=5000000
# IMAGE_TOKEN_ESTIMATE=1600
# EST_PROMPT_TOKENS=300
# EST_COMPLETION_TOKENS=400
# ANTHROPIC_CACHE_TTL=5m
